    },
    {
      "name": "5. Gateway & Actuator Verification",
      "item": [
        {
          "name": "Gateway - Routes",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/actuator/gateway/routes",
              "host": ["{{baseUrl}}"],
              "path": ["actuator", "gateway", "routes"]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 200', () => pm.response.to.have.status(200));",
                  "const body = pm.response.json();",
                  "pm.test('Catalog route exists', () => pm.expect(body.some(r => r.route_id === 'catalog-service')).to.be.true);",
                  "pm.test('Order route exists', () => pm.expect(body.some(r => r.route_id === 'order-service')).to.be.true);",
                  "pm.test('Rating route exists', () => pm.expect(body.some(r => r.route_id === 'rating-service')).to.be.true);",
                  "pm.test('Notification route exists', () => pm.expect(body.some(r => r.route_id === 'notification-service')).to.be.true);"
                ]
              }
            }
          ]
        },
        {
          "name": "Gateway - Health",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
